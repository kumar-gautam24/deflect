DATABASE_URL=postgresql+asyncpg://deflect:deflect@localhost:5432/deflect

# Provider. Groq's free tier runs the whole stack; get a key at
# https://console.groq.com/keys. Only the gpt-oss models accept schema-constrained
# output, and the answer service cannot work without it, so the client refuses any other.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Only needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# production disables the interactive API docs, which are an inventory of the attack
# surface and are not browsed on a deployed service.
ENV=development

# Service-to-service and operator credentials. Both are required: every service refuses
# to start with either unset, so a misconfigured deploy never takes traffic. The same
# SERVICE_TOKEN must be given to all four services.
# Generate with: openssl rand -hex 32
SERVICE_TOKEN=
OPERATOR_TOKEN=

# Job transport, and since the auth service exists, the place every service looks to
# resolve a session. Losing it costs in-flight delivery rather than history -- Postgres
# carries truth -- but anything that can WRITE it can mint an admin session, so it is
# password-protected rather than open even locally.
REDIS_PASSWORD=dev-redis-password
REDIS_URL=redis://:dev-redis-password@localhost:6379/0

# Ingest refuses any path outside this directory.
CORPUS_ROOT=/corpus

WEB_ORIGIN=http://localhost:3000
